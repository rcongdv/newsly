# App
DEBUG=false
LOG_LEVEL=INFO

# Timezone & Recipients
TIMEZONE=America/Los_Angeles
DEFAULT_RECIPIENT=you@example.com

# Google OAuth (required)
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_REFRESH_TOKEN=
GMAIL_PUBSUB_TOPIC_NAME=

# Grok AI (required)
GROK_API_KEY=
GROK_MODEL=grok-3-mini

# TTS Settings
TTS_PROVIDER=pytts
TTS_OUTPUT_FORMAT=mp3
TTS_OUTPUT_FILE=output
TTS_LANGUAGE=en

# ElevenLabs (only if TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# PyTTS (only if TTS_PROVIDER=pytts)
PYTTS_VOICE_RATE=125
PYTTS_VOLUME=1.0
PYTTS_VOICE_ID=0

# Google Cloud TTS (only if TTS_PROVIDER=google)
# GOOGLE_TTS_CREDENTIALS_PATH=
# GOOGLE_TTS_LANGUAGE_CODE=en-US
# GOOGLE_TTS_VOICE_NAME=
# GOOGLE_TTS_VOICE_GENDER=NEUTRAL
# GOOGLE_TTS_SPEAKING_RATE=1.0
# GOOGLE_TTS_PITCH=0.0

# Video Generation (optional)
# VIDEO_ENABLED=false
# VIDEO_OUTPUT_FORMAT=mp4
# VIDEO_OUTPUT_FILE=output
# VIDEO_BACKGROUND_COLOR=#1a1a2e
# VIDEO_BACKGROUND_IMAGE=
# VIDEO_WIDTH=1080
# VIDEO_HEIGHT=1080

# Subtitles (for video generation)
# SUBTITLE_FONT_SIZE=48
# SUBTITLE_FONT_COLOR=white
# SUBTITLE_MAX_CHARS_PER_LINE=60

# Database (required)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/newsly
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30

# Email Filtering (comma-separated domains)
EMAIL_WHITELIST=
