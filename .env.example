# App
DEBUG=false
LOG_LEVEL=INFO

# Timezone & Recipients
TIMEZONE=America/Los_Angeles
DEFAULT_RECIPIENT=you@example.com

# Google OAuth (required)
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_REFRESH_TOKEN=
GMAIL_PUBSUB_TOPIC_NAME=

# Grok AI (required)
GROK_API_KEY=
GROK_MODEL=grok-3-mini

# TTS Settings
TTS_PROVIDER=pytts
TTS_OUTPUT_FORMAT=mp3
TTS_OUTPUT_FILE=output
TTS_LANGUAGE=en

# ElevenLabs (only if TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# PyTTS (only if TTS_PROVIDER=pytts)
PYTTS_VOICE_RATE=125
PYTTS_VOLUME=1.0
PYTTS_VOICE_ID=0

# Database (required)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/newsly

# Email Filtering (comma-separated domains)
EMAIL_WHITELIST=
